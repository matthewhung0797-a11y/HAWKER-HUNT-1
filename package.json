{
  "name": "hawker-hunt",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "Chrome >= 69",
    "Android >= 7",
    "iOS >= 12",
    "Firefox >= 62",
    "Safari >= 12",
    "Edge >= 79"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "facing:check": "node scripts/check-facing.mjs",
    "facing:static": "node scripts/check-facing-static.mjs",
    "facing:diff": "node scripts/check-facing.mjs --diff",
    "facing:golden": "node scripts/check-facing.mjs --golden",
    "facing:golden:all": "node scripts/check-facing.mjs --golden --all",
    "facing:golden:write": "node scripts/check-facing.mjs --write-golden",
    "facing:golden:write:all": "node scripts/check-facing.mjs --write-golden --all",
    "playtest": "node scripts/playtest/run.mjs --suite=human",
    "playtest:1k": "node scripts/playtest/run.mjs --suite=load --n=1000",
    "playtest:human": "node scripts/playtest/run.mjs --suite=human",
    "playtest:all": "node scripts/playtest/run.mjs --suite=all",
    "playtest:facing": "node scripts/playtest/run.mjs --suite=facing",
    "playtest:check": "node scripts/playtest/check.mjs",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:build:android": "npx cap sync android && cd android && .\\gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.110.1",
    "jsqr": "^1.4.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.10",
    "next-intl": "^4.13.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.0",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.2",
    "@serwist/next": "^9.5.12",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "eruda": "^3.4.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "obj2gltf": "^3.2.0",
    "playwright": "^1.61.1",
    "serwist": "^9.5.12",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}
